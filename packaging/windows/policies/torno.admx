<?xml version="1.0" encoding="utf-8"?>
<!--
  Group Policy and Intune template for Torno (docs/book/src/guide/managed-deployment.md).
  The app reads these values in crates/ui-egui/src/policy.rs: keep the two in step.
  Intune's import takes no combo boxes and wants every namespace it references uploaded first, so
  this file uses none of either. The target namespace never changes; a new policy raises revision.
-->
<policyDefinitions xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions" revision="1.1" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="torno" namespace="TangencyLabs.Policies.Torno" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Torno_0_44" displayName="$(string.SUPPORTED_Torno_0_44)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Torno" displayName="$(string.Torno)" />
  </categories>
  <policies>
    <policy name="CheckForUpdates" class="Both" displayName="$(string.CheckForUpdates)" explainText="$(string.CheckForUpdates_Explain)" presentation="$(presentation.CheckForUpdates)" key="Software\Policies\Torno" valueName="CheckForUpdates">
      <parentCategory ref="Torno" />
      <supportedOn ref="SUPPORTED_Torno_0_44" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="OrganizationName" class="Both" displayName="$(string.OrganizationName)" explainText="$(string.OrganizationName_Explain)" presentation="$(presentation.OrganizationName)" key="Software\Policies\Torno">
      <parentCategory ref="Torno" />
      <supportedOn ref="SUPPORTED_Torno_0_44" />
      <elements>
        <text id="OrganizationName" valueName="OrganizationName" maxLength="64" required="true" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
